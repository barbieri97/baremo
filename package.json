{
  "name": "baremo",
  "version": "0.3.0",
  "description": "Baremo Desktop — agregação de resultados normativos, documentos e relatórios em neuropsicologia",
  "author": "Baremo",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "desktopName": "baremo.desktop",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,vue}\" \"tests/**/*.ts\"",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "pack:dir": "npm run build && electron-builder --dir",
    "release": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "echarts": "^6.1.0",
    "electron-updater": "^6.8.9",
    "file-type": "^22.0.2",
    "isomorphic-dompurify": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/extension-character-count": "^3.30.5",
    "@tiptap/extension-code-block-lowlight": "^3.30.5",
    "@tiptap/extension-color": "^3.30.5",
    "@tiptap/extension-focus": "^3.30.5",
    "@tiptap/extension-font-family": "^3.30.5",
    "@tiptap/extension-highlight": "^3.30.5",
    "@tiptap/extension-image": "^3.30.5",
    "@tiptap/extension-link": "^3.30.5",
    "@tiptap/extension-placeholder": "^3.30.5",
    "@tiptap/extension-subscript": "^3.30.5",
    "@tiptap/extension-superscript": "^3.30.5",
    "@tiptap/extension-table": "^3.30.5",
    "@tiptap/extension-task-item": "^3.30.5",
    "@tiptap/extension-task-list": "^3.30.5",
    "@tiptap/extension-text-align": "^3.30.5",
    "@tiptap/extension-text-style": "^3.30.5",
    "@tiptap/extension-typography": "^3.30.5",
    "@tiptap/extension-underline": "^3.30.5",
    "@tiptap/extensions": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@tiptap/suggestion": "^3.30.5",
    "@tiptap/vue-3": "^3.30.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.6.0",
    "drizzle-kit": "^0.31.10",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.5.0",
    "globals": "^17.11.0",
    "lowlight": "^3.3.0",
    "pdfjs-dist": "^6.2.108",
    "pinia": "^4.0.3",
    "prettier": "^3.9.6",
    "reka-ui": "^2.10.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "vue": "^3.5.42",
    "vue-router": "^4.5.1",
    "vue-tsc": "^3.3.11",
    "zod": "^4.4.3"
  }
}
