<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Electron precisa destes dois para funcionar sob o hardened runtime: o V8
    gera código em memória executável.
  -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!--
    Rede de SAÍDA apenas, e usada só pelo módulo de IA (desligado por padrão) e
    pelo verificador de atualizações. O app não abre porta nenhuma: não há
    servidor HTTP local (premissa P5).
  -->
  <key>com.apple.security.network.client</key>
  <true/>

  <!--
    Leitura e escrita de arquivos escolhidos pelo usuário — anexar protocolos
    digitalizados e salvar PDFs exportados.
  -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
